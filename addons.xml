    </extension>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <license>MIT</license>
        <summary lang="en_GB">Easy Kodi cleaner and maintenance tool.</summary>
        <summary lang="pt_PT">Ferramenta simples de limpeza e manutenção do Kodi.</summary>
